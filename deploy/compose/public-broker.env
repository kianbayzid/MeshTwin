# Setting 2: a public community broker.
# Non-secret settings only; credentials live in .env (PUBLIC_MQTT_*).
#
# Read access is NOT open: LetsMesh and MeshMapper brokers let observers
# publish with node-key tokens, but reading needs a subscribe-only account
# created by the operator. Ask for "full access" (role 2): the "limited"
# role strips SNR/RSSI, which this project needs. See docs/data-sources.md.
MODE=live
# LetsMesh US broker (MQTT over secure WebSockets). MeshMapper: wss://mqtt.meshmapper.net:443/
MQTT_URL=wss://mqtt-us-v1.letsmesh.net:443/
# Region filter: subscribe to one region only, never meshcore/#.
MQTT_TOPIC=meshcore/SEA/+/packets
# Politeness cap: a busy region is tens of messages/sec.
MQTT_MAX_PER_SEC=200
FLUSH_AGE=5m
# QoS 0, clean session: a shared broker shouldn't queue for us (politeness),
# so messages published while the ingester is down are lost.
MQTT_QOS=0
MQTT_CLEAN_SESSION=true
