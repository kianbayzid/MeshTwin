# Copy to .env (git-ignored) and fill in. Never commit real values.
# Object store (SeaweedFS) S3 identity, shared by seaweedfs, the ingester and the api.
S3_ACCESS_KEY=meshtwin
S3_SECRET_KEY=change-me-to-something-long

# Setting 1 (own observer): your observer and the ingester log in to the
# bundled mosquitto with these.
OBSERVER_MQTT_USERNAME=observer
OBSERVER_MQTT_PASSWORD=change-me-too

# Setting 2 (public broker): the subscribe-only account the broker operator gave you.
PUBLIC_MQTT_USERNAME=
PUBLIC_MQTT_PASSWORD=
