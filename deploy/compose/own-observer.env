# Setting 1: your own MeshCore observer.
# Non-secret settings only; credentials live in .env (OBSERVER_MQTT_*).
MODE=live
# The bundled mosquitto. Using your own broker? e.g. tcp://192.168.1.20:1883 or ssl://broker.example:8883
MQTT_URL=tcp://mosquitto:1883
# Region filter: the IATA code your observer publishes under.
MQTT_TOPIC=meshcore/SEA/+/packets
# One observer produces a few messages/sec at most; cap well above that.
# With QoS 1 the cap throttles (backpressure): a post-restart backlog drains, not drops.
MQTT_MAX_PER_SEC=50
FLUSH_AGE=5m
# DDIL: our own broker queues for us (QoS 1, persistent session keyed by the
# client ID) while the ingester restarts; failed S3 uploads wait in the spool.
MQTT_QOS=1
MQTT_CLEAN_SESSION=false
MQTT_CLIENT_ID=meshtwin-ingester
SPOOL_DIR=/spool
SPOOL_MAX_BYTES=1073741824
DRAIN_RATE_BYTES=0
