{
  "title": "MeshTwin",
  "uid": "meshtwin",
  "tags": [
    "meshtwin"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Ingester",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Messages / s by result",
      "description": "ok = stored; everything else was dropped or skipped.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(meshtwin_ingest_messages_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Dropped / s",
      "description": "Politeness caps (rate_limited, oversize) and bad input.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(meshtwin_ingest_messages_total{result=~\"rate_limited|oversize|decode_error|bad_topic|shutdown\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "MQTT connected",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meshtwin_ingest_mqtt_connected)",
          "legendFormat": "connected"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Rows buffered (not yet in S3)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(meshtwin_ingest_rows_buffered)",
          "legendFormat": "rows"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "S3 writes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(meshtwin_ingest_files_written_total[15m])) * 60",
          "legendFormat": "files / min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(meshtwin_ingest_bytes_written_total[15m]))",
          "legendFormat": "bytes / s"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Flush errors (15 min)",
      "description": "Failed flushes keep rows buffered and retry. Hash mismatches should stay 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(meshtwin_ingest_flush_errors_total[15m]))",
          "legendFormat": "flush errors"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(meshtwin_ingest_hash_mismatch_total[15m]))",
          "legendFormat": "hash mismatches"
        }
      ]
    },
    {
      "type": "row",
      "id": 14,
      "title": "DDIL (S3 outage buffering)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "id": 15,
      "title": "Storage up",
      "description": "0 = S3 unreachable, new files go to the spool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meshtwin_ingest_storage_up)",
          "legendFormat": "S3 up"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Spool size",
      "description": "Bytes waiting to upload, against SPOOL_MAX_BYTES (oldest evicted above it).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meshtwin_ingest_spool_bytes)",
          "legendFormat": "spool"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meshtwin_ingest_spool_max_bytes)",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "Spool files",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meshtwin_ingest_spool_files)",
          "legendFormat": "files"
        }
      ]
    },
    {
      "type": "stat",
      "id": 18,
      "title": "Oldest spooled",
      "description": "Age of the oldest file not yet in S3 (alert above 1 h).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 18,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meshtwin_ingest_spool_oldest_age_seconds)",
          "legendFormat": "oldest"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Spool writes vs uploads",
      "description": "Writes = failed S3 uploads parked on disk; uploads = drained back to S3.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(meshtwin_ingest_spool_writes_total[5m])) * 60",
          "legendFormat": "writes / min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(meshtwin_ingest_spool_uploads_total[5m])) * 60",
          "legendFormat": "uploads / min"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Evicted (data lost)",
      "description": "Any value above 0 is lost data: the spool was full.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(meshtwin_ingest_spool_evicted_files_total[15m]))",
          "legendFormat": "files / 15 min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(meshtwin_ingest_spool_evicted_bytes_total[15m]))",
          "legendFormat": "bytes / 15 min"
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Requests / s by route",
      "description": "Includes the readiness probe on /api/v1/regions (every 30 s per replica).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(meshtwin_api_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "p95 latency by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(meshtwin_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Errors / s by code",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(meshtwin_api_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Summary validation failures (1 h)",
      "description": "Summaries rejected by the privacy/contract checks. Anything above 0 alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (summary) (increase(meshtwin_api_summary_validation_failures_total[1h]))",
          "legendFormat": "{{summary}}"
        }
      ]
    },
    {
      "type": "table",
      "id": 13,
      "title": "Summary age",
      "description": "Now minus meta.generated_at. Alert at 2x schedule: 10 min for topology/resilience, 2 h for residuals/surprising/placement/coverage, 48 h for terrain.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 43,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (region, summary) (meshtwin_api_summary_generated_timestamp_seconds)",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
