# Setting 1: your own MeshCore observer.
# Non-secret settings only; credentials live in .env (OBSERVER_MQTT_*).
MODE=live
# The bundled mosquitto. Using your own broker? e.g. tcp://192.168.1.20:1883 or ssl://broker.example:8883
MQTT_URL=tcp://mosquitto:1883
# Region filter: the IATA code your observer publishes under.
MQTT_TOPIC=meshcore/SEA/+/packets
# One observer produces a few messages/sec at most; cap well above that.
MQTT_MAX_PER_SEC=50
FLUSH_AGE=5m
